{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jpe-ansible/homelab-contracts/schemas/secrets-arrangement-v1.json",
  "title": "OpenBao secrets arrangement contract",
  "description": "Validates the shape and path grammar of an OpenBao secrets arrangement. It does not cross-check that grant identities exist in identities or that grant zones are declared in zones; role tests enforce those references.",
  "type": "object",
  "required": ["schema_version", "description", "zones", "services", "identities", "grants", "raw_grants"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": 1 },
    "description": { "type": "string" },
    "zones": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/zone" }
    },
    "services": {
      "type": "array",
      "items": { "$ref": "#/$defs/service" }
    },
    "identities": {
      "type": "object",
      "patternProperties": {
        "^[a-z][a-z0-9-]*$": { "$ref": "#/$defs/identity" }
      },
      "additionalProperties": false
    },
    "grants": {
      "type": "array",
      "items": { "$ref": "#/$defs/grant" }
    },
    "raw_grants": {
      "type": "array",
      "items": { "$ref": "#/$defs/rawGrant" }
    }
  },
  "$defs": {
    "segment": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "identityName": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "zone": {
      "type": "object",
      "required": ["name", "description"],
      "additionalProperties": false,
      "properties": {
        "name": {
          "$ref": "#/$defs/segment",
          "not": {
            "enum": ["admin", "config", "state", "sys", "auth", "identity", "cubbyhole", "secret"]
          }
        },
        "description": { "type": "string" }
      }
    },
    "service": {
      "type": "object",
      "required": ["zone", "service", "instances"],
      "additionalProperties": false,
      "properties": {
        "zone": { "$ref": "#/$defs/segment" },
        "service": { "$ref": "#/$defs/segment" },
        "instances": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/segment" }
        },
        "description": { "type": "string" }
      }
    },
    "identity": {
      "type": "object",
      "required": ["class", "login"],
      "additionalProperties": false,
      "properties": {
        "class": {
          "type": "string",
          "enum": ["everyday", "service", "sandbox", "automation", "sudo", "restricted", "operator"]
        },
        "login": {
          "type": "string",
          "enum": ["approle", "jwt", "userpass", "oidc"]
        },
        "description": { "type": "string" }
      }
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": ["read", "list", "create", "update", "patch", "delete"]
      }
    },
    "rawCapabilities": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": ["read", "list", "create", "update", "patch", "delete", "sudo", "deny"]
      }
    },
    "grantPath": {
      "type": "string",
      "oneOf": [
        {
          "pattern": "^(?!(?:admin|config|state|sys|auth|identity|cubbyhole|secret)/)(?:[a-z0-9][a-z0-9-]*|\\+)/(?:[a-z0-9][a-z0-9-]*|\\+)/(?:[a-z0-9][a-z0-9-]*|\\+)/(?:ro|rw|self|\\+)$"
        },
        {
          "pattern": "^admin/(?:[a-z0-9][a-z0-9-]*|\\+)/(?:[a-z0-9][a-z0-9-]*|\\+)/(?:[a-z0-9][a-z0-9-]*|\\+)/(?:admin|management|owner|root|\\+)$"
        },
        {
          "pattern": "^config/(?:[a-z0-9][a-z0-9-]*|\\+)/(?:[a-z0-9][a-z0-9-]*|\\+)$"
        }
      ]
    },
    "rawPath": {
      "type": "string",
      "pattern": "^(?!admin/)(?!config/)[a-z][a-z0-9-]*/[A-Za-z0-9_+*/.-]+$"
    },
    "grant": {
      "type": "object",
      "required": ["identity", "path"],
      "additionalProperties": false,
      "properties": {
        "identity": { "$ref": "#/$defs/identityName" },
        "path": { "$ref": "#/$defs/grantPath" },
        "capabilities": { "$ref": "#/$defs/capabilities" }
      }
    },
    "rawGrant": {
      "type": "object",
      "required": ["identity", "path", "capabilities"],
      "additionalProperties": false,
      "properties": {
        "identity": { "$ref": "#/$defs/identityName" },
        "path": { "$ref": "#/$defs/rawPath" },
        "capabilities": { "$ref": "#/$defs/rawCapabilities" }
      }
    }
  }
}

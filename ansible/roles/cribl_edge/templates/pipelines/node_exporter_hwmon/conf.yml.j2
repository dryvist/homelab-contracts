---
# Metric-name filter for the in_node_exporter source (pre-processing pipeline)
# Generated by Ansible - do not edit manually
#
# node_exporter exposes hundreds of series per scrape; only the hardware
# sensor series in cribl_edge_node_exporter_keep_match are wanted, so
# everything else is dropped at the input and never reaches either metrics leg.

output: default
streamtags: []
groups: {}
asyncFuncTimeout: 1000
functions:
  - id: drop
    filter: "!/{{ cribl_edge_node_exporter_keep_match }}/.test(_metric)"
    disabled: false
    conf: {}

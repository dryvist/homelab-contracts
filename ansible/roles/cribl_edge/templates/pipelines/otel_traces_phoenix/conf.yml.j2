---
# OTLP trace filter for the in_otel source (pre-processing pipeline)
# Generated by Ansible - do not edit manually
#
# Phoenix ingests traces only. Drop other signals before they reach the
# destination so retries cannot accumulate non-trace payloads in its queue.

output: phoenix_otlp
streamtags: []
groups: {}
asyncFuncTimeout: 1000
functions:
  - id: drop
    filter: "!__otlp || __otlp.type !== 'traces'"
    disabled: false
    conf: {}

---
# OTel non-trace event pipeline for the in_otel source (Cribl routes table).
# Generated by Ansible - do not edit manually
#
# routes.yml.j2 filters spans out before events reach this pipeline. Preserve
# the existing Splunk metadata stamps for the remaining OTLP event payloads.

output: splunk_hec
streamtags: []
groups: {}
asyncFuncTimeout: 1000
functions:
  - id: eval
    filter: "true"
    disabled: false
    conf:
      add:
        - name: index
          value: "index || 'otel'"
        - name: sourcetype
          value: "sourcetype || 'otel:span'"
        - name: source
          value: "source || 'cribl-edge-otel'"

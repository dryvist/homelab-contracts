{
  "schema_version": 1,
  "description": "Harness gateway identities, trust tiers, and consumer classes; consumers read this file, and deployment JSON may override trust_tier per id.",
  "tiers": ["trusted", "untrusted"],
  "default_tier": "untrusted",

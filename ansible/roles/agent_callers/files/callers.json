    "opencode-trusted": {"trust_tier": "trusted", "consumer_class": "interactive"},
    "hermes": {"trust_tier": "trusted", "consumer_class": "hermes"},
    "hermes-private": {"trust_tier": "trusted", "consumer_class": "hermes"},
    "donna": {"trust_tier": "trusted", "consumer_class": "hermes"},
    "opencode-untrusted": {"trust_tier": "untrusted", "consumer_class": "untrusted"},
    "claude-zai": {"trust_tier": "untrusted", "consumer_class": "untrusted"},
    "zcode": {"trust_tier": "untrusted", "consumer_class": "untrusted"},
    "antigravity-cli": {"trust_tier": "trusted", "consumer_class": "interactive"}
  }
}

#!/usr/bin/env bash
# flow-lock — non-IaC homelab mutation lease + gated credential injection.
#
# Every mutating flow (tofu plan/apply, ansible-playbook, deployment.json edits,
# inventory sync) runs as:
#
#   flow-lock run --flow deployment-edit --creds rustfs -- deployment-json edit
#
# The lease is one OpenBao KV v2 key (create-if-absent via cas=0; the KV version
# number is the fencing token). Runtime credentials live ONLY in OpenBao and are
# injected into the child environment after the lease is held — no lease, no
# creds, so concurrent flows are excluded by construction, not convention.
#
# Environment (OpenBao connection plus the AppRole issuer identity):
#   BAO_ADDR                 OpenBao URL (required)
#   OPENBAO_APPROLE_APPROLE_ISSUER_ROLE_ID
#   OPENBAO_APPROLE_APPROLE_ISSUER_SECRET_ID
#                            approle-issuer credentials; mints a fresh,
#                            single-use flow-lock secret_id for each command
#   BAO_TOKEN                optional pre-issued approle-issuer token
#   FLOW_LOCK_MOUNT          KV v2 mount            (default: secret)
#   FLOW_LOCK_KEY            lease key              (default: locks/global)
#   FLOW_LOCK_CREDS_BASE     creds path prefix      (default: infra)
#   FLOW_LOCK_BOOTSTRAP=1    escape hatch: NO lease, NO creds, loud banner —
#                            only for managing OpenBao itself when it is down.
#
# Exit codes: child's own code on success path; 75 lease acquire timeout
# (EX_TEMPFAIL, scriptable retry); 70 OpenBao/internal error; 64 usage.

set -euo pipefail

# The old standing flow-lock pair is no longer an input and must not reach the
# child command while callers finish removing those Doppler entries.
unset FLOW_LOCK_ROLE_ID FLOW_LOCK_SECRET_ID

FLOW_LOCK_MOUNT="${FLOW_LOCK_MOUNT:-secret}"
FLOW_LOCK_KEY="${FLOW_LOCK_KEY:-locks/global}"
FLOW_LOCK_CREDS_BASE="${FLOW_LOCK_CREDS_BASE:-infra}"

EX_USAGE=64
EX_SOFTWARE=70
EX_TEMPFAIL=75

usage() {
  cat <<'EOF'
Usage:
  flow-lock run [--flow NAME] [--ttl 15m] [--timeout 10m] [--creds a,b,...] -- CMD [ARGS...]
  flow-lock approle-token ROLE
  flow-lock status
  flow-lock break --reason STR [--yes]
  flow-lock release --lease-id UUID
  flow-lock help

run      Acquire the global lease, inject gated creds, exec CMD, release.
approle-token ROLE  Mint and log in with one fresh secret_id for ROLE.
status   Show the current lease holder (if any).
break    Force-break a stuck lease (audited; prompts unless --yes).
release  Clean up a lease left by a crashed wrapper (lease-id must match).
EOF
}

log() { printf 'flow-lock: %s\n' "$*" >&2; }
die() { log "$1"; exit "${2:-$EX_SOFTWARE}"; }

# "15m" / "2h" / "90s" / bare seconds -> seconds
ttl_to_seconds() {
  local v="$1" n unit
  case "$v" in
    *[hms]) n="${v%?}"; unit="${v#"${v%?}"}" ;;
    *) n="$v"; unit="s" ;;
  esac
  case "$n" in
    ''|*[!0-9]*) die "invalid duration: $v" "$EX_USAGE" ;;
  esac
  case "$unit" in
    h) printf '%d' "$(( n * 3600 ))" ;;
    m) printf '%d' "$(( n * 60 ))" ;;
    s) printf '%d' "$(( n ))" ;;
  esac
}

require_env() {
  [ -n "${BAO_ADDR:-}" ] || die "BAO_ADDR is not set" "$EX_USAGE"
  command -v curl >/dev/null || die "curl not found"
  command -v jq >/dev/null || die "jq not found"
}

# ---- OpenBao HTTP helpers ---------------------------------------------------

BAO_ISSUER_TOKEN_CACHED=""
BAO_TOKEN_CACHED=""
MINTED_APPROLE_TOKEN=""
MINTED_APPROLE_NAME=""
MINTED_APPROLE_SECRET_ID_ACCESSOR=""

clear_issuer_credentials() {
  unset BAO_TOKEN OPENBAO_APPROLE_APPROLE_ISSUER_ROLE_ID
  unset OPENBAO_APPROLE_APPROLE_ISSUER_SECRET_ID
}

# AppRole login accepts its JSON body on stdin so secret_ids never appear in
# curl's arguments. The response is returned to the caller for immediate use.
approle_login() {
  local role_id="$1" secret_id="$2" response status body
  response="$(
    OPENBAO_LOGIN_ROLE_ID="$role_id" OPENBAO_LOGIN_SECRET_ID="$secret_id" \
      jq -nc '{role_id:env.OPENBAO_LOGIN_ROLE_ID,secret_id:env.OPENBAO_LOGIN_SECRET_ID}' |
      curl -sS -X POST -H 'Content-Type: application/json' \
        -w '\n%{http_code}' --data-binary @- "$BAO_ADDR/v1/auth/approle/login"
  )" || die "AppRole login request failed (is OpenBao up at $BAO_ADDR?)"
  status="$(printf '%s\n' "$response" | awk 'END { print }')"
  body="$(printf '%s' "$response" | sed '$d')"
  [ "$status" = "200" ] || die "AppRole login rejected: $(jq -r '.errors[0] // "unknown error"' <<<"$body" 2>/dev/null)"
  jq -er '.auth.client_token' <<<"$body" 2>/dev/null \
    || die "AppRole login response did not contain a client token"
}

bao_issuer_token() {
  [ -n "$BAO_ISSUER_TOKEN_CACHED" ] && return 0
  local provided_token issuer_role_id issuer_secret_id
  provided_token="$(printenv BAO_TOKEN 2>/dev/null || true)"
  if [ -n "$provided_token" ]; then
    BAO_ISSUER_TOKEN_CACHED="$provided_token"
  else
    issuer_role_id="$(printenv OPENBAO_APPROLE_APPROLE_ISSUER_ROLE_ID 2>/dev/null || true)"
    issuer_secret_id="$(printenv OPENBAO_APPROLE_APPROLE_ISSUER_SECRET_ID 2>/dev/null || true)"
    if [ -z "$issuer_role_id" ] || [ -z "$issuer_secret_id" ]; then
      die "no BAO_TOKEN or OPENBAO_APPROLE_APPROLE_ISSUER_ROLE_ID/SECRET_ID" "$EX_USAGE"
    fi
    BAO_ISSUER_TOKEN_CACHED="$(approle_login "$issuer_role_id" "$issuer_secret_id")"
  fi
  # Neither the minting identity nor the obsolete flow-lock pair should reach
  # the wrapped command. bao_token() retains only the narrower flow-lock token.
  clear_issuer_credentials
  unset issuer_role_id issuer_secret_id provided_token
}

# curl reads the token header through a pipe-backed config, not its argv. The
# body, when present, contains no credential material.
bao_api_with_token() {
  local method="$1" path="$2" token="$3" body="${4:-}"
  local args=(--config - -sS -X "$method" -H 'Content-Type: application/json'
    -w '\n%{http_code}'
    "$BAO_ADDR/v1/$path")
  [ -n "$body" ] && args+=(-d "$body")
  printf 'header = "X-Vault-Token: %s"\n' "$token" | curl "${args[@]}"
}

revoke_minted_approle_secret_id() {
  [ -n "$MINTED_APPROLE_SECRET_ID_ACCESSOR" ] || return 0
  [ -n "$BAO_ISSUER_TOKEN_CACHED" ] || {
    log "could not revoke the temporary $MINTED_APPROLE_NAME secret_id: issuer token unavailable"
    return 1
  }

  local body response status
  body="$(OPENBAO_SECRET_ID_ACCESSOR="$MINTED_APPROLE_SECRET_ID_ACCESSOR" \
    jq -nc '{secret_id_accessor:env.OPENBAO_SECRET_ID_ACCESSOR}')"
  response="$(bao_api_with_token POST \
    "auth/approle/role/$MINTED_APPROLE_NAME/secret-id-accessor/destroy" \
    "$BAO_ISSUER_TOKEN_CACHED" "$body")" || {
      log "could not revoke the temporary $MINTED_APPROLE_NAME secret_id"
      return 1
    }
  status="$(printf '%s\n' "$response" | awk 'END { print }')"
  case "$status" in
    200|204)
      MINTED_APPROLE_NAME=""
      MINTED_APPROLE_SECRET_ID_ACCESSOR=""
      return 0
      ;;
    *)
      log "temporary $MINTED_APPROLE_NAME secret_id revocation failed (HTTP $status)"
      return 1
      ;;
  esac
}

cleanup_minted_approle_secret_id_on_exit() {
  local exit_code=$?
  trap - EXIT
  if ! revoke_minted_approle_secret_id && [ "$exit_code" -eq 0 ]; then
    exit_code="$EX_SOFTWARE"
  fi
  exit "$exit_code"
}
trap cleanup_minted_approle_secret_id_on_exit EXIT

mint_approle_token() {
  local approle_name="$1"
  [[ "$approle_name" =~ ^[A-Za-z0-9_-]+$ ]] \
    || die "invalid AppRole name: $approle_name" "$EX_USAGE"
  local issuer_token role_response secret_response status body role_id secret_id
  local secret_id_accessor client_token
  bao_issuer_token
  issuer_token="$BAO_ISSUER_TOKEN_CACHED"

  role_response="$(bao_api_with_token GET "auth/approle/role/$approle_name/role-id" "$issuer_token" '')" \
    || die "could not read the $approle_name role id from OpenBao"
  status="$(printf '%s\n' "$role_response" | awk 'END { print }')"
  body="$(printf '%s' "$role_response" | sed '$d')"
  [ "$status" = "200" ] || die "$approle_name role-id read failed (HTTP $status)"
  role_id="$(jq -er '.data.role_id' <<<"$body" 2>/dev/null)" \
    || die "$approle_name role-id response did not contain a role id"

  secret_response="$(bao_api_with_token POST "auth/approle/role/$approle_name/secret-id" "$issuer_token" '')" \
    || die "could not mint a $approle_name secret id from OpenBao"
  status="$(printf '%s\n' "$secret_response" | awk 'END { print }')"
  body="$(printf '%s' "$secret_response" | sed '$d')"
  [ "$status" = "200" ] || die "$approle_name secret-id mint failed (HTTP $status)"
  secret_id="$(jq -er '.data.secret_id' <<<"$body" 2>/dev/null)" \
    || die "$approle_name secret-id response did not contain a secret id"
  secret_id_accessor="$(jq -er '.data.secret_id_accessor' <<<"$body" 2>/dev/null)" \
    || die "$approle_name secret-id response did not contain an accessor"
  MINTED_APPROLE_NAME="$approle_name"
  MINTED_APPROLE_SECRET_ID_ACCESSOR="$secret_id_accessor"
  unset issuer_token role_response secret_response body secret_id_accessor

  if client_token="$(approle_login "$role_id" "$secret_id")"; then
    MINTED_APPROLE_TOKEN="$client_token"
  else
    unset role_id secret_id client_token
    revoke_minted_approle_secret_id || die "could not revoke the temporary $approle_name secret_id"
    die "could not log in with the temporary $approle_name secret_id"
  fi
  unset role_id secret_id client_token
  revoke_minted_approle_secret_id \
    || die "could not revoke the temporary $approle_name secret_id"
  BAO_ISSUER_TOKEN_CACHED=""
}

bao_token() {
  if [ -n "$BAO_TOKEN_CACHED" ]; then printf '%s' "$BAO_TOKEN_CACHED"; return; fi
  mint_approle_token flow-lock
  BAO_TOKEN_CACHED="$MINTED_APPROLE_TOKEN"
  printf '%s' "$BAO_TOKEN_CACHED"
}

cmd_approle_token() {
  [ "$#" -eq 1 ] || die "approle-token: exactly one ROLE is required" "$EX_USAGE"
  require_env
  # The caller may already hold a different BAO_TOKEN (for example, the
  # runner's SSH-signing identity). Mint only with the dedicated issuer pair.
  unset BAO_TOKEN
  mint_approle_token "$1"
  printf '%s' "$MINTED_APPROLE_TOKEN"
}

# bao_api METHOD PATH [JSON_BODY] -> body on stdout; returns curl/HTTP status
bao_api() {
  local method="$1" path="$2" body=""
  [ "$#" -lt 3 ] || body="$3"
  [ -n "$BAO_TOKEN_CACHED" ] || die "flow-lock token was not initialized"
  bao_api_with_token "$method" "$path" "$BAO_TOKEN_CACHED" "$body"
}

# splits the bao_api combined output into BAO_BODY / BAO_STATUS globals
bao_call() {
  local out
  out="$(bao_api "$@")" || die "OpenBao unreachable at $BAO_ADDR"
  BAO_STATUS="${out##*$'\n'}"
  BAO_BODY="${out%$'\n'*}"
}

kv_data_path() { printf '%s/data/%s' "$FLOW_LOCK_MOUNT" "$1"; }
kv_meta_path() { printf '%s/metadata/%s' "$FLOW_LOCK_MOUNT" "$1"; }

# ---- lease primitives -------------------------------------------------------

lease_payload() {
  local lease_id="$1" ttl_s="$2" renewals="$3"
  jq -nc \
    --arg lease_id "$lease_id" \
    --arg holder_user "${USER:-unknown}" \
    --arg holder_host "$(hostname -s 2>/dev/null || echo unknown)" \
    --arg holder_pid "$$" \
    --arg flow "$FLOW_NAME" \
    --arg repo "$(basename "$(git rev-parse --show-toplevel 2>/dev/null || echo "$PWD")")" \
    --argjson acquired_at "$(date +%s)" \
    --argjson expires_at "$(( $(date +%s) + ttl_s ))" \
    --argjson renewals "$renewals" \
    '{lease_id:$lease_id,
      holder:{user:$holder_user,host:$holder_host,pid:($holder_pid|tonumber)},
      flow:$flow, repo:$repo,
      acquired_at:$acquired_at, expires_at:$expires_at, renewals:$renewals}'
}

# try_put CAS PAYLOAD -> sets PUT_VERSION on success, returns 1 on CAS conflict
try_put() {
  local cas="$1" payload="$2"
  bao_call POST "$(kv_data_path "$FLOW_LOCK_KEY")" \
    "$(jq -nc --argjson cas "$cas" --argjson data "$payload" '{options:{cas:$cas},data:$data}')"
  case "$BAO_STATUS" in
    200) PUT_VERSION="$(jq -r '.data.version' <<<"$BAO_BODY")"; return 0 ;;
    400) return 1 ;;  # CAS mismatch — someone else holds/beat us
    *) die "lease write failed (HTTP $BAO_STATUS): $(jq -r '.errors[0] // .' <<<"$BAO_BODY" 2>/dev/null)" ;;
  esac
}

# reads current lease; sets CUR_VERSION (0 = absent) and CUR_DATA (json or empty)
read_lease() {
  bao_call GET "$(kv_data_path "$FLOW_LOCK_KEY")"
  case "$BAO_STATUS" in
    200)
      CUR_VERSION="$(jq -r '.data.metadata.version' <<<"$BAO_BODY")"
      CUR_DATA="$(jq -c '.data.data' <<<"$BAO_BODY")"
      # a soft-deleted version reads as null data — treat as absent
      if [ "$CUR_DATA" = "null" ]; then CUR_DATA=""; fi
      ;;
    404) CUR_VERSION=0; CUR_DATA="" ;;
    *) die "lease read failed (HTTP $BAO_STATUS)" ;;
  esac
}

meta_delete() {
  bao_call DELETE "$(kv_meta_path "$FLOW_LOCK_KEY")"
  case "$BAO_STATUS" in
    204|200) return 0 ;;
    *) die "lease delete failed (HTTP $BAO_STATUS)" ;;
  esac
}

describe_holder() {
  jq -r '"held by \(.holder.user)@\(.holder.host) pid \(.holder.pid) — flow=\(.flow) repo=\(.repo) — expires \(.expires_at | todate) (renewals: \(.renewals))"' \
    <<<"$1" 2>/dev/null || echo "held (unparseable payload)"
}

new_lease_id() {
  if command -v uuidgen >/dev/null; then
    uuidgen | tr '[:upper:]' '[:lower:]'
  else
    od -An -N16 -tx1 /dev/urandom | tr -d ' \n'
  fi
}

# acquire TTL_S TIMEOUT_S -> sets LEASE_ID + LEASE_VERSION
acquire() {
  local ttl_s="$1" timeout_s="$2" deadline=$(( $(date +%s) + $2 ))
  LEASE_ID="$(new_lease_id)"
  while :; do
    if try_put 0 "$(lease_payload "$LEASE_ID" "$ttl_s" 0)"; then
      LEASE_VERSION="$PUT_VERSION"; return 0
    fi
    read_lease
    if [ -n "$CUR_DATA" ]; then
      local expires_at
      expires_at="$(jq -r '.expires_at // 0' <<<"$CUR_DATA")"
      if [ "$(date +%s)" -gt "$expires_at" ]; then
        # expired lease: takeover via CAS on the exact observed version —
        # exactly one contender wins; never delete-then-create (that races)
        if try_put "$CUR_VERSION" "$(lease_payload "$LEASE_ID" "$ttl_s" 0)"; then
          log "took over an EXPIRED lease ($(describe_holder "$CUR_DATA"))"
          LEASE_VERSION="$PUT_VERSION"; return 0
        fi
        continue
      fi
      log "waiting: $(describe_holder "$CUR_DATA")"
    else
      # key exists but data soft-deleted/empty: cas=0 will keep failing until a
      # metadata delete; recover by taking over the version we just observed
      if try_put "$CUR_VERSION" "$(lease_payload "$LEASE_ID" "$ttl_s" 0)"; then
        LEASE_VERSION="$PUT_VERSION"; return 0
      fi
      continue
    fi
    [ "$(date +%s)" -lt "$deadline" ] || { log "timed out after ${timeout_s}s"; exit "$EX_TEMPFAIL"; }
    sleep $(( 5 + RANDOM % 10 ))
  done
}

# background renewer: rewrites the lease with cas=<own version> every ttl/3.
# On CAS failure (someone force-broke us) it warns loudly but does NOT kill the
# child — killing a mid-flight apply is worse than a brief overlap.
renew_loop() {
  local ttl_s="$1" version="$2" renewals=0 payload
  while :; do
    sleep $(( ttl_s / 3 )) || return 0
    renewals=$(( renewals + 1 ))
    payload="$(lease_payload "$LEASE_ID" "$ttl_s" "$renewals")"
    if try_put "$version" "$payload" 2>/dev/null; then
      version="$PUT_VERSION"
      printf '%s' "$version" > "$RENEW_STATE"
    else
      log "WARNING: lease renewal lost (force-break or takeover?) — child keeps running; investigate with 'flow-lock status'"
      printf 'LOST' > "$RENEW_STATE"
      return 0
    fi
  done
}

# ---- creds injection --------------------------------------------------------

# fetch secret/<base>/<name> and export every data key verbatim
inject_creds() {
  local name="$1"
  bao_call GET "$(kv_data_path "$FLOW_LOCK_CREDS_BASE/$name")"
  [ "$BAO_STATUS" = 200 ] || die "creds '$name' not readable (HTTP $BAO_STATUS) — is $FLOW_LOCK_CREDS_BASE/$name seeded and your AppRole policy correct?"
  local kv
  while IFS= read -r kv; do
    export "${kv%%=*}"="${kv#*=}"
  done < <(jq -r '.data.data | to_entries[] | "\(.key)=\(.value)"' <<<"$BAO_BODY")
  log "injected creds: $name ($(jq -r '.data.data | keys | join(", ")' <<<"$BAO_BODY"))"
}

# ---- subcommands ------------------------------------------------------------

cmd_run() {
  FLOW_NAME="manual"; local ttl="15m" timeout="10m" creds=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --flow) FLOW_NAME="$2"; shift 2 ;;
      --ttl) ttl="$2"; shift 2 ;;
      --timeout) timeout="$2"; shift 2 ;;
      --creds) creds="$2"; shift 2 ;;
      --) shift; break ;;
      *) die "unknown option for run: $1" "$EX_USAGE" ;;
    esac
  done
  [ $# -gt 0 ] || die "run: no command given (use: flow-lock run [opts] -- CMD)" "$EX_USAGE"

  if [ "${FLOW_LOCK_BOOTSTRAP:-}" = "1" ]; then
    clear_issuer_credentials
    log "==============================================================="
    log "BOOTSTRAP MODE: NO lease held, NO gated creds injected."
    log "Only valid for managing OpenBao itself while it is down."
    log "==============================================================="
    "$@"; exit $?
  fi

  require_env
  local ttl_s timeout_s
  ttl_s="$(ttl_to_seconds "$ttl")"
  timeout_s="$(ttl_to_seconds "$timeout")"
  bao_token >/dev/null

  acquire "$ttl_s" "$timeout_s"
  log "lease acquired (lease_id=$LEASE_ID version=$LEASE_VERSION ttl=${ttl_s}s flow=$FLOW_NAME)"

  RENEW_STATE="$(mktemp)"
  printf '%s' "$LEASE_VERSION" > "$RENEW_STATE"
  renew_loop "$ttl_s" "$LEASE_VERSION" &
  local renewer_pid=$!

  # Invoked via the EXIT trap below — SC2317/SC2329 are the same "unreachable
  # function" false positive reported under different shellcheck versions.
  # shellcheck disable=SC2329,SC2317
  cleanup() {
    kill "$renewer_pid" 2>/dev/null || true
    wait "$renewer_pid" 2>/dev/null || true
    if [ "$(cat "$RENEW_STATE" 2>/dev/null)" != "LOST" ]; then
      read_lease
      if [ -n "$CUR_DATA" ] && [ "$(jq -r '.lease_id' <<<"$CUR_DATA")" = "$LEASE_ID" ]; then
        meta_delete && log "lease released"
      fi
    fi
    rm -f "$RENEW_STATE"
  }
  trap cleanup EXIT

  if [ -n "$creds" ]; then
    local c
    for c in ${creds//,/ }; do inject_creds "$c"; done
  fi

  export FLOW_LOCK_LEASE_ID="$LEASE_ID"
  export FLOW_LOCK_VERSION="$LEASE_VERSION"
  export FLOW_LOCK_EXPIRES_AT="$(( $(date +%s) + ttl_s ))"

  local rc=0
  "$@" || rc=$?
  local renew_state
  renew_state="$(cat "$RENEW_STATE" 2>/dev/null || true)"
  if [ "$renew_state" = "LOST" ]; then
    log "ERROR: lease was lost mid-run — treat this run's exclusivity as compromised"
    [ "$rc" -eq 0 ] && rc="$EX_SOFTWARE"
  fi
  exit "$rc"
}

cmd_status() {
  require_env
  bao_token >/dev/null
  read_lease
  if [ -z "$CUR_DATA" ]; then
    echo "flow-lock: free (no lease held)"
  else
    echo "flow-lock: $(describe_holder "$CUR_DATA")"
    if [ "$(date +%s)" -gt "$(jq -r '.expires_at // 0' <<<"$CUR_DATA")" ]; then
      echo "flow-lock: lease is EXPIRED — next acquire will take over"
    fi
  fi
}

cmd_break() {
  local reason="" yes=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --reason) reason="$2"; shift 2 ;;
      --yes) yes=1; shift ;;
      *) die "unknown option for break: $1" "$EX_USAGE" ;;
    esac
  done
  [ -n "$reason" ] || die "break: --reason is required" "$EX_USAGE"
  require_env
  bao_token >/dev/null
  read_lease
  [ -n "$CUR_DATA" ] || { echo "flow-lock: nothing to break (free)"; exit 0; }
  echo "flow-lock: about to FORCE-BREAK: $(describe_holder "$CUR_DATA")"
  if [ -z "$yes" ]; then
    printf 'Type "break" to confirm: '
    read -r confirm
    [ "$confirm" = "break" ] || die "aborted" "$EX_USAGE"
  fi
  local audit_key
  audit_key="locks/audit/$(date -u +%Y%m%dT%H%M%SZ)"
  bao_call POST "$(kv_data_path "$audit_key")" \
    "$(jq -nc --arg reason "$reason" --arg by "${USER:-unknown}@$(hostname -s 2>/dev/null || echo unknown)" \
        --argjson victim "$CUR_DATA" \
        '{data:{action:"force-break", reason:$reason, by:$by, at:(now|floor), victim:$victim}}')"
  [ "$BAO_STATUS" = 200 ] || log "WARNING: audit write failed (HTTP $BAO_STATUS) — breaking anyway"
  meta_delete
  echo "flow-lock: lease broken (audited at $audit_key)"
}

cmd_release() {
  local lease_id=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --lease-id) lease_id="$2"; shift 2 ;;
      *) die "unknown option for release: $1" "$EX_USAGE" ;;
    esac
  done
  [ -n "$lease_id" ] || die "release: --lease-id is required" "$EX_USAGE"
  require_env
  bao_token >/dev/null
  read_lease
  [ -n "$CUR_DATA" ] || { echo "flow-lock: already free"; exit 0; }
  local held_id
  held_id="$(jq -r '.lease_id' <<<"$CUR_DATA")"
  [ "$held_id" = "$lease_id" ] \
    || die "refusing: current lease is $held_id, not $lease_id (use 'flow-lock break' if it is truly stuck)"
  meta_delete
  echo "flow-lock: lease $lease_id released"
}

case "${1:-}" in
  run) shift; cmd_run "$@" ;;
  approle-token) shift; cmd_approle_token "$@" ;;
  status) shift; cmd_status "$@" ;;
  break) shift; cmd_break "$@" ;;
  release) shift; cmd_release "$@" ;;
  help|--help|-h) usage ;;
  '') usage >&2; exit "$EX_USAGE" ;;
  *) log "unknown subcommand: $1"; usage >&2; exit "$EX_USAGE" ;;
esac

{
  "schema_version": 1,
  "description": "Placeholder secrets arrangement: two zones, one identity per class, least-privilege grants.",
  "zones": [
    { "name": "example-zone", "description": "Services reachable only inside the network." },
    { "name": "example-ext", "description": "Internet-reachable vendor keys." }
  ],
  "services": [
    {
      "zone": "example-zone",
      "service": "example-svc",
      "instances": ["example-instance", "example-instance-two"],
      "description": "Example service instances."
    },
    { "zone": "example-ext", "service": "example-vendor", "instances": ["main"] }
  ],
  "identities": {
    "example-everyday": { "class": "everyday", "login": "approle", "description": "Routine interactive reads." },
    "example-service": { "class": "service", "login": "jwt", "description": "A workload reading its own leaf." },
    "example-sandbox": { "class": "sandbox", "login": "approle" },
    "example-automation": { "class": "automation", "login": "approle", "description": "Unattended converge and rotation." },
    "example-sudo": { "class": "sudo", "login": "oidc" },
    "example-restricted": { "class": "restricted", "login": "oidc" },
    "example-operator": { "class": "operator", "login": "userpass", "description": "The full-access operator session." }
  },
  "grants": [
    { "identity": "example-everyday", "path": "example-zone/+/+/ro" },
    { "identity": "example-everyday", "path": "config/+/+", "capabilities": ["read", "list"] },
    { "identity": "example-service", "path": "example-zone/example-svc/example-instance/self" },
    { "identity": "example-service", "path": "config/example-svc/example-instance" },
    { "identity": "example-sandbox", "path": "example-ext/example-vendor/main/ro" },
    {
      "identity": "example-automation",
      "path": "example-zone/example-svc/+/rw",
      "capabilities": ["read", "create", "update", "patch"]
    },
    {
      "identity": "example-automation",
      "path": "admin/example-zone/example-svc/example-instance/management",
      "capabilities": ["read"]
    },
    { "identity": "example-sudo", "path": "admin/example-ext/example-vendor/main/owner" },
    { "identity": "example-restricted", "path": "example-ext/example-vendor/+/rw" },
    {
      "identity": "example-operator",
      "path": "+/+/+/+",
      "capabilities": ["read", "list", "create", "update", "patch", "delete"]
    },
    {
      "identity": "example-operator",
      "path": "admin/+/+/+/+",
      "capabilities": ["read", "list", "create", "update", "patch", "delete"]
    }
  ],
  "raw_grants": [
    {
      "identity": "example-automation",
      "path": "state/example-flow/*",
      "capabilities": ["read", "create", "update"]
    },
    {
      "identity": "example-service",
      "path": "example-engine/token/example-set",
      "capabilities": ["read"]
    },
    {
      "identity": "example-operator",
      "path": "sys/generate-root/*",
      "capabilities": ["deny"]
    }
  ]
}

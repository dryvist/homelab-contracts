{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/dryvist/homelab-contracts/schemas/callers-v1.json",
  "title": "dryvist AI harness caller registry contract",
  "description": "schema_version 1. Shape of ansible/roles/agent_callers/files/callers.json. Tier membership and the untrusted consumer-class invariant are asserted by tests/agent_callers/test_contract.yml.",
  "type": "object",
  "required": ["schema_version", "description", "tiers", "default_tier", "callers"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": 1 },
    "description": { "type": "string" },
    "tiers": { "$ref": "#/$defs/names", "minItems": 1 },
    "default_tier": { "type": "string", "pattern": "^[a-z][a-z0-9_-]*$" },
    "callers": {
      "type": "object",
      "propertyNames": { "pattern": "^[a-z][a-z0-9-]*$" },
      "additionalProperties": {
        "type": "object",
        "required": ["trust_tier", "consumer_class"],
        "additionalProperties": false,
        "properties": {
          "trust_tier": { "type": "string", "pattern": "^[a-z][a-z0-9_-]*$" },
          "consumer_class": {
            "type": "string",
            "enum": ["interactive", "hermes", "ci", "batch", "untrusted"]
          }
        }
      }
    }
  },
  "$defs": {
    "names": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z][a-z0-9_-]*$" }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/dryvist/homelab-contracts/schemas/model-policy-v1.json",
  "title": "Self-hosted model policy",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "as_of",
    "max_age_days",
    "deny",
    "models",
    "exempt_hosted"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "as_of": {
      "$ref": "#/$defs/date"
    },
    "max_age_days": {
      "type": "integer",
      "minimum": 1,
      "maximum": 365
    },
    "deny": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "reason"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "models": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "upstream_id",
          "upstream_created",
          "dossier"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/repo"
          },
          "upstream_id": {
            "$ref": "#/$defs/repo"
          },
          "upstream_created": {
            "$ref": "#/$defs/date"
          },
          "dossier": {
            "type": "string",
            "pattern": "^ansible/roles/llm_model_catalog/files/dossiers/[A-Za-z0-9_-]+\\.md$"
          }
        }
      }
    },
    "exempt_hosted": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "reason"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "const": "hosted provider"
          }
        }
      }
    }
  },
  "$defs": {
    "date": {
      "type": "string",
      "format": "date",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "repo": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
    }
  }
}
